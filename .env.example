# ==========================================
# ZERO TRACE Environment Configuration
# ==========================================

# Server Port
PORT=3001
NODE_ENV=production

# Storage Location (Encrypted ciphertext chunks and manifests)
# Ensure the host directory is readable/writable by the application process
STORAGE_DIR=./storage

# Database Engine: 'sqlite' or 'postgres'
# Leave blank to use zero-config embedded SQLite (ideal for single-node / Tor instances)
# Or provide PostgreSQL URI for high-concurrency production deployments:
# DATABASE_URL=postgres://zerotrace_user:zerotrace_secure_pass_2026@localhost:5432/zerotrace_db

# Cryptographic Salt for Owner Deletion Tokens
# Generate with: openssl rand -hex 32
SERVER_HMAC_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upload Ceilings & Limits
MAX_FILE_SIZE_BYTES=209715200 # 200 MB maximum per share

# Privacy-Preserving Rate Limiting
RATE_LIMIT_MAX_REQUESTS=150
RATE_LIMIT_WINDOW_MS=60000

# Cleanup daemon check interval (milliseconds)
CLEANUP_INTERVAL_MS=30000

# Optional CORS allowed origins (comma-separated, default is restrictive same-origin)
# ALLOWED_ORIGINS=https://zerotrace.example.org
